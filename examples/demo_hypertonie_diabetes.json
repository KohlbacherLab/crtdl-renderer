          ]
        }
      ],
      [
        {
          "context": {
            "code": "Diagnose",
            "system": "fdpg.mii.cds",
            "version": "1.0.0",
            "display": "Diagnose"
          },
          "termCodes": [
            {
              "code": "E11.9",
              "system": "http://fhir.de/CodeSystem/bfarm/icd-10-gm",
              "version": "2024",
              "display": "Diabetes mellitus, Typ 2: Ohne Komplikationen, nicht als entgleist bezeichnet"
            }
          ],
          "attributeFilters": [
            {
              "type": "concept",
              "attributeCode": {
                "code": "diagnosesicherheit",
                "system": "mii.abide",
                "display": "Diagnosesicherheit"
              },
              "selectedConcepts": [
                {
                  "code": "G",
                  "system": "https://fhir.kbv.de/CodeSystem/KBV_CS_SFHIR_ICD_DIAGNOSESICHERHEIT",
