      ],
      [
        {
          "context": {
            "code": "Laboruntersuchung",
            "system": "fdpg.mii.cds",
            "version": "1.0.0",
            "display": "Laboruntersuchung"
          },
          "termCodes": [
            {
              "code": "4548-4",
              "system": "http://loinc.org",
              "display": "Hemoglobin A1c/Hemoglobin.total in Blood"
