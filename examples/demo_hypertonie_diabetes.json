            }
          ],
          "timeRestriction": { "afterDate": "2020-01-01", "beforeDate": "2024-12-31" }
        },
        {
          "context": {
            "code": "Diagnose",
            "system": "fdpg.mii.cds",
            "version": "1.0.0",
            "display": "Diagnose"
          },
          "termCodes": [
            {
              "code": "I11.9",
              "system": "http://fhir.de/CodeSystem/bfarm/icd-10-gm",
