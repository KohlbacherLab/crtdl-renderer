              "display": "Diabetes mellitus, während der Schwangerschaft auftretend"
            }
          ]
        }
      ],
      [
        {
          "context": {
            "code": "Prozedur",
            "system": "fdpg.mii.cds",
            "version": "1.0.0",
            "display": "Prozedur"
          },
          "termCodes": [
            {
              "code": "8-854",
              "system": "http://fhir.de/CodeSystem/bfarm/ops",
              "version": "2024",
              "display": "Hämodialyse"
            }
          ]
        },
        {
          "context": {
            "code": "Laboruntersuchung",
            "system": "fdpg.mii.cds",
            "version": "1.0.0",
            "display": "Laboruntersuchung"
          },
          "termCodes": [
            {
              "code": "2160-0",
              "system": "http://loinc.org",
              "display": "Creatinine [Mass/volume] in Serum or Plasma"
            }
          ],
          "valueFilter": {
            "type": "quantity-range",
            "minValue": 3.0,
            "maxValue": 15.0,
            "unit": { "code": "mg/dL", "display": "mg/dl" }
          }
        }
      ]
    ]
  },
  "dataExtraction": {
    "attributeGroups": [
      {
        "id": "grp-patient",
        "groupReference": "https://www.medizininformatik-initiative.de/fhir/core/modul-person/StructureDefinition/Patient",
        "attributes": [
          { "attributeRef": "Patient.gender", "mustHave": false },
          { "attributeRef": "Patient.birthDate", "mustHave": true }
        ]
      },
      {
        "id": "grp-labor",
        "name": "HbA1c-Laborwerte",
        "groupReference": "https://www.medizininformatik-initiative.de/fhir/core/modul-labor/StructureDefinition/ObservationLab",
        "attributes": [
          { "attributeRef": "Observation.code", "mustHave": false },
          { "attributeRef": "Observation.value", "mustHave": true },
          { "attributeRef": "Observation.encounter", "mustHave": false, "linkedGroups": ["grp-fall"] }
        ],
        "filter": [
          {
            "type": "token",
            "name": "code",
            "codes": [
              { "code": "4548-4", "system": "http://loinc.org", "display": "Hemoglobin A1c/Hemoglobin.total in Blood" },
              { "code": "17856-6", "system": "http://loinc.org", "display": "Hemoglobin A1c/Hemoglobin.total in Blood by HPLC" }
            ]
          },
          { "type": "date", "name": "date", "start": "2022-01-01", "end": "2024-12-31" }
        ]
      },
      {
        "id": "grp-fall",
        "groupReference": "https://www.medizininformatik-initiative.de/fhir/core/modul-fall/StructureDefinition/KontaktGesundheitseinrichtung",
        "includeReferenceOnly": true,
        "attributes": [
          { "attributeRef": "Encounter.period", "mustHave": false },
          { "attributeRef": "Encounter.diagnosis", "mustHave": false }
        ]
      }
    ]
